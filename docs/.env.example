# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Admin API Key (generate a random string)
API_KEY=your_api_key_here

# Workers API URL (set after deploying worker)
NEXT_PUBLIC_API_URL=https://your-worker.your-subdomain.workers.dev

# Staff-only form response-copy email (Worker secrets; never commit real values)
# FORM_RESPONSE_EMAIL_ENCRYPTION_KEY: random 24+ character encryption secret
FORM_RESPONSE_EMAIL_ENCRYPTION_KEY=replace_with_random_secret
# JSON map: exact operator name -> sha256("form-response-email-operator-v1:" + personal key)
FORM_RESPONSE_EMAIL_OPERATOR_KEY_HASHES={"Operator Name":"replace_with_64_lowercase_hex_characters"}
