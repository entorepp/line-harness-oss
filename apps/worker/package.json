{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:form-file-access": "esbuild scripts/test-form-file-access.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-form-file-access-test.mjs && node /tmp/flat-harness-form-file-access-test.mjs",
    "test:form-file-upload": "esbuild scripts/test-form-file-upload.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-form-file-upload-test.mjs && node /tmp/flat-harness-form-file-upload-test.mjs",
    "test:whatsapp-initiation": "esbuild scripts/test-whatsapp-initiation.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-whatsapp-initiation-test.mjs && node /tmp/flat-harness-whatsapp-initiation-test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@line-crm/db": "workspace:*",
    "@line-crm/line-sdk": "workspace:*",
    "@line-crm/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "25.5.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
