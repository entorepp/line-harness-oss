{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:travel-quote-route": "esbuild scripts/test-travel-quote-route.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-travel-quote-test.mjs && node /tmp/flat-harness-travel-quote-test.mjs",
    "test:form-response-email": "esbuild scripts/test-form-response-email.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-form-response-email-test.mjs && node /tmp/flat-harness-form-response-email-test.mjs",
    "test:form-response-email-route": "esbuild scripts/test-form-response-email-route.ts --bundle --platform=node --format=esm --outfile=/tmp/flat-harness-form-response-email-route-test.mjs && node /tmp/flat-harness-form-response-email-route-test.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@line-crm/db": "workspace:*",
    "@line-crm/line-sdk": "workspace:*",
    "@line-crm/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
